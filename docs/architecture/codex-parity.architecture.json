  "cards": [
    {
      "dot": "emerald",
      "title": "已實作與驗證",
      "items": [
        "G1–G5：Flow、筆記、語音、計畫及 Mac 差異路由已實作。",
        "假服務回歸與 Xcode 建置通過；不代表真實帳號、語音或裝置已驗收。"
      ]
    },
    {
      "dot": "amber",
      "title": "隔離與授權",
      "items": [
        "背景文字需明確啟用；專用 HOME 與鑰匙圈項目不含原生 refresh token。",
        "每次請求分開 process／thread／工作目錄，停用本機工具、hooks、plugins、skills 與 MCP。",
        "閒置／退出嘗試清空 access 資料；鑰匙圈鎖定時可能延後清理。"
      ]
    },
    {
      "dot": "slate",
      "title": "桌面與歷史邊界",
      "items": [
        "自有對話依 thread／turn／request 回覆；外部 Desktop 用既有權限 hooks 或明確問題插件。",
        "不能接管任意外部內建提問；修改差異保留既有有上限的歷史。"
      ]
    }
  ]
