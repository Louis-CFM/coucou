    "iphone.instruction.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التعليمات المُرسَلة من iPhone تستخدم النموذج المفتوح حاليًا في الدردشة. يُطبَّق موجه النظام وتاريخ المحادثة. التعليمات المُرسَلة أثناء توقف Coucou تُضاف إلى قائمة الانتظار وتُنفَّذ عند التشغيل التالي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone থেকে পাঠানো নির্দেশনা চ্যাটে বর্তমানে খোলা মডেল ব্যবহার করে। সিস্টেম প্রম্পট এবং কথোপকথনের ইতিহাস প্রযোজ্য। Coucou চলছে না থাকলে পাঠানো নির্দেশনাগুলো কিউতে রাখা হয় এবং পরবর্তী চালুতে চালানো হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An instruction sent from the iPhone uses the model open in chat. The system prompt and conversation history apply. Instructions sent when Coucou is not running are queued and executed on next launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una instrucción enviada desde el iPhone usa el modelo abierto actualmente en el chat. Se aplican el prompt de sistema y el historial de conversación. Las instrucciones enviadas mientras Coucou no está en ejecución se ponen en cola y se ejecutan en el siguiente inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une instruction envoyée depuis l'iPhone utilise le modèle ouvert dans le chat. Le prompt système et l'historique de conversation s'appliquent. Les instructions envoyées quand Coucou ne tourne pas sont mises en file d'attente et exécutées au prochain démarrage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone से भेजा गया निर्देश चैट में वर्तमान में खुले मॉडल का उपयोग करता है। सिस्टम प्रॉम्प्ट और बातचीत का इतिहास लागू होता है। Coucou चल नहीं रहे होने पर भेजे गए निर्देश कतार में रखे जाते हैं और अगली बार चालू होने पर चलाए जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instruksi yang dikirim dari iPhone menggunakan model yang sedang terbuka di chat. Prompt sistem dan riwayat percakapan berlaku. Instruksi yang dikirim saat Coucou tidak berjalan dimasukkan ke antrean dan dijalankan saat peluncuran berikutnya."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma instrução enviada pelo iPhone usa o modelo aberto no momento no chat. O prompt de sistema e o histórico de conversa se aplicam. Instruções enviadas enquanto o Coucou não está em execução ficam na fila e são executadas no próximo início."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструкция, отправленная с iPhone, использует модель, открытую в чате. Системный промпт и история разговора применяются. Инструкции, отправленные пока Coucou не запущен, ставятся в очередь и выполняются при следующем запуске."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 iPhone 发送的指令使用聊天中当前打开的模型。系统提示和对话历史适用。Coucou 未运行时发送的指令将排队，并在下次启动时执行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 전송된 지침은 채팅에 열려 있는 모델을 사용합니다. 시스템 프롬프트와 대화 기록이 적용됩니다. Coucou가 실행되지 않을 때 전송된 지침은 대기열에 추가되어 다음 실행 시 실행됩니다."
          }
        }
      }
    },
    "iphone.instruction.toggle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح لـ iPhone بإرسال تعليمات إلى Claude Code"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমার iPhone-কে Claude Code-এ নির্দেশ পাঠাতে দাও"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let my iPhone send instructions to Claude Code"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que mi iPhone envíe instrucciones a Claude Code"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser mon iPhone envoyer des instructions à Claude Code"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरे iPhone को Claude Code को निर्देश भेजने दें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan iPhone saya mengirim instruksi ke Claude Code"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixar meu iPhone enviar instruções ao Claude Code"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволять iPhone отправлять инструкции в Claude Code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许我的 iPhone 向 Claude Code 发送指令"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 iPhone이 Claude Code에 지침을 보낼 수 있도록 허용"
          }
        }
      }
    },
    "iphone.live-activity.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمر عبر ريلاي Coucou إلى خدمة Apple للإشعارات. يُرسَل فقط اسم الوكيل وحالته: لا اسم مشروع ولا أمر ولا مسار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-এর পুশ সার্ভিসে Coucou রিলের মাধ্যমে যায়। শুধুমাত্র এজেন্টের নাম এবং অবস্থা পাঠানো হয়: কোনো প্রজেক্ট নাম, কমান্ড বা পাথ নয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goes through the Coucou relay to Apple's push service. Only the agent name and state are sent: no project name, command, or path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa por el relay de Coucou al servicio push de Apple. Solo se envían el nombre y el estado del agente: sin nombre de proyecto, comando ni ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe par le relais Coucou vers le service push d'Apple. Seuls le nom et l'état de l'agent sont envoyés : aucun nom de projet, commande ou chemin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou रिले के माध्यम से Apple के पुश सर्विस से जाता है। केवल एजेंट का नाम और स्थिति भेजी जाती है: कोई प्रोजेक्ट नाम, कमांड या पाथ नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melewati relay Coucou ke layanan push Apple. Hanya nama dan status agen yang dikirim: tanpa nama proyek, perintah, atau jalur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa pelo relay do Coucou para o serviço push da Apple. Apenas o nome e o estado do agente são enviados: sem nome de projeto, comando ou caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проходит через ретранслятор Coucou к сервису push Apple. Отправляются только имя и состояние агента: без имени проекта, команды или пути."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Coucou 中继传至 Apple 推送服务。仅发送 Agent 的名称和状态：不含项目名称、命令或路径。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou 릴레이를 통해 Apple의 푸시 서비스로 이동합니다. 에이전트 이름과 상태만 전송되며 프로젝트 이름, 명령 또는 경로는 전송되지 않습니다."
          }
        }
      }
    },
    "iphone.live-activity.toggle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل Mochi إلى Dynamic Island في iPhone عند إغلاق Mac"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac লক থাকলে Mochi-কে আমার iPhone-এর Dynamic Island-এ নিয়ে যান"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Mochi to my iPhone's Dynamic Island when my Mac is locked"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover a Mochi a la Dynamic Island de mi iPhone cuando mi Mac esté bloqueado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer Mochi vers la Dynamic Island de mon iPhone quand mon Mac est verrouillé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac लॉक होने पर Mochi को मेरे iPhone की Dynamic Island पर ले जाएं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindahkan Mochi ke Dynamic Island iPhone saya saat Mac terkunci"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover o Mochi para a Dynamic Island do meu iPhone quando meu Mac estiver bloqueado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переносить Mochi на Dynamic Island моего iPhone, когда Mac заблокирован"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 锁定时将 Mochi 移至我 iPhone 的灵动岛"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 잠겨 있을 때 Mochi를 내 iPhone의 Dynamic Island로 이동"
          }
        }
      }
    },
    "iphone.sync.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسل جلساتك إلى iCloud الخاص بك لتطبيق Coucou على iPhone. تُشفَّر أسماء المشاريع والأوامر والأسئلة بمفاتيح iCloud الخاصة بك. إيقاف التشغيل يحذفها من iCloud."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou iPhone অ্যাপের জন্য আপনার সেশনগুলো আপনার প্রাইভেট iCloud-এ পাঠায়। প্রজেক্টের নাম, কমান্ড এবং প্রশ্নগুলো আপনার iCloud কী দিয়ে এনক্রিপ্ট করা হয়। বন্ধ করলে iCloud থেকে মুছে যাবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends your sessions to your private iCloud for the Coucou app on iPhone. Project names, commands, and questions are encrypted with your iCloud keys. Disabling removes data from iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía tus sesiones a tu iCloud privado para la app Coucou de iPhone. Los nombres de proyecto, comandos y preguntas se cifran con tus claves de iCloud. Desactivarlo las elimina de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie tes sessions sur ton iCloud privé pour l'app Coucou sur iPhone. Les noms de projets, commandes et questions sont chiffrés avec tes clés iCloud. Désactiver supprime les données d'iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou iPhone ऐप के लिए आपके सेशन आपके प्राइवेट iCloud में भेजता है। प्रोजेक्ट नाम, कमांड और सवाल आपकी iCloud कुंजियों से एन्क्रिप्ट किए जाते हैं। बंद करने पर iCloud से हटा दिए जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim sesi Anda ke iCloud pribadi Anda untuk aplikasi Coucou iPhone. Nama proyek, perintah, dan pertanyaan dienkripsi dengan kunci iCloud Anda. Mematikannya menghapusnya dari iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia suas sessões para seu iCloud privado para o app Coucou no iPhone. Nomes de projetos, comandos e perguntas são criptografados com suas chaves do iCloud. Desativar remove-os do iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет твои сессии в личный iCloud для приложения Coucou на iPhone. Имена проектов, команды и вопросы шифруются твоими ключами iCloud. Отключение удаляет их из iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你的会话发送到私有 iCloud，供 Coucou iPhone 应用使用。项目名称、命令和问题使用你的 iCloud 密钥加密。关闭后将从 iCloud 中删除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone의 Coucou 앱을 위해 세션을 비공개 iCloud로 전송합니다. 프로젝트 이름, 명령 및 질문은 iCloud 키로 암호화됩니다. 비활성화하면 iCloud에서 데이터가 삭제됩니다."
          }
        }
      }
    },
