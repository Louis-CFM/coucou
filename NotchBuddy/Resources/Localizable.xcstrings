    "flow.translate-detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدّث بأي لغة: تُلصق كلماتك باللغة التي تختارها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেকোনো ভাষায় বলুন: আপনার কথা আপনার বেছে নেওয়া ভাষায় পেস্ট হবে।"
