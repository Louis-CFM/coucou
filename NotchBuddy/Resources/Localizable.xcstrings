    "Drop a file named like one of Mochi's sounds (finish.wav, approval.mp3, greet.m4a…) in the sounds folder to replace it, then Reload.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع في مجلد الأصوات ملفًا يحمل اسم أحد أصوات Mochi (finish.wav وapproval.mp3 وgreet.m4a…) ليحل محله، ثم أعد التحميل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mochi-র কোনো সাউন্ডের নামে একটি ফাইল (finish.wav, approval.mp3, greet.m4a…) সাউন্ড ফোল্ডারে রাখুন, সেটি বদলে যাবে; তারপর Reload করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop a file named like one of Mochi's sounds (finish.wav, approval.mp3, greet.m4a…) in the sounds folder to replace it, then Reload."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja en la carpeta de sonidos un archivo con el nombre de uno de los sonidos de Mochi (finish.wav, approval.mp3, greet.m4a…) para reemplazarlo y luego recarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez dans le dossier des sons un fichier nommé comme l'un des sons de Mochi (finish.wav, approval.mp3, greet.m4a…) pour le remplacer, puis rechargez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mochi की किसी साउंड के नाम वाली फ़ाइल (finish.wav, approval.mp3, greet.m4a…) साउंड फ़ोल्डर में रखें, वह उसकी जगह ले लेगी; फिर Reload करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Taruh file bernama seperti salah satu suara Mochi (finish.wav, approval.mp3, greet.m4a…) di folder suara untuk menggantinya, lalu muat ulang."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque na pasta de sons um arquivo com o nome de um dos sons do Mochi (finish.wav, approval.mp3, greet.m4a…) para substituí-lo e depois recarregue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Положите в папку звуков файл с именем одного из звуков Mochi (finish.wav, approval.mp3, greet.m4a…), чтобы заменить его, затем перезагрузите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在声音文件夹中放入与 Mochi 某个声音同名的文件（finish.wav、approval.mp3、greet.m4a…）即可替换它，然后重新载入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사운드 폴더에 Mochi의 사운드 이름(finish.wav, approval.mp3, greet.m4a…)과 일치하는 파일을 드롭하여 교체한 다음 다시 로드하세요."
          }
        }
      }
    },
    "Drop a file or window, or ask me anything.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسقط ملفاً أو نافذة، أو اسألني أي شيء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ফাইল বা উইন্ডো ড্রপ করুন, অথবা যেকোনো কিছু জিজ্ঞেস করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop a file or window, or ask me anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta un archivo o ventana, o pregúntame cualquier cosa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépose un fichier ou une fenêtre, ou demande-moi n'importe quoi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई फ़ाइल या विंडो ड्रॉप करें, या कुछ भी पूछें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret file atau jendela, atau tanya apa saja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte um arquivo ou janela, ou me pergunte qualquer coisa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Брось файл или окно, или спроси меня о чём угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖入文件或窗口，或问我任何问题。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이나 창을 드롭하거나, 무엇이든 물어보세요."
          }
        }
      }
    },
