          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks desatualizados — atualize-os para responder às perguntas do Claude pelo notch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
