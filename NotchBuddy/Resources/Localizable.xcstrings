    "flow.prompt-mode-detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قل فكرتك كيفما اتفق: تُلصق كموجّه واضح (الهدف، السياق، الخطوات، القيود، متى يكتمل)، جاهز لـ Claude Code أو Cursor أو ChatGPT."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার আইডিয়া যেমন খুশি বলুন: সেটি স্পষ্ট প্রম্পট হয়ে পেস্ট হবে (লক্ষ্য, প্রসঙ্গ, ধাপ, শর্ত, কখন শেষ), Claude Code, Cursor বা ChatGPT-এর জন্য তৈরি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich deine Idee einfach aus: Sie wird als klarer Prompt eingefügt (Ziel, Kontext, Schritte, Einschränkungen und Abschlusskriterien), bereit für Claude Code, Cursor oder ChatGPT."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say your idea any old way: it's pasted as a clear prompt (goal, context, steps, constraints, done when), ready for Claude Code, Cursor or ChatGPT."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di tu idea como te salga: se pega como un prompt claro (objetivo, contexto, pasos, restricciones, terminado cuando), listo para Claude Code, Cursor o ChatGPT."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis ton idée en vrac : elle est collée comme un prompt clair (objectif, contexte, étapes, contraintes, fini quand), prêt pour Claude Code, Cursor ou ChatGPT."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना आइडिया जैसे भी बोलें: वह एक साफ़ प्रॉम्प्ट (लक्ष्य, संदर्भ, चरण, शर्तें, कब पूरा) बनकर पेस्ट होगा, Claude Code, Cursor या ChatGPT के लिए तैयार।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucapkan idemu sesukamu: hasilnya ditempel sebagai prompt yang jelas (tujuan, konteks, langkah, batasan, selesai jika), siap untuk Claude Code, Cursor, atau ChatGPT."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fale sua ideia do jeito que vier: ela é colada como um prompt claro (objetivo, contexto, etapas, restrições, pronto quando), pronto para Claude Code, Cursor ou ChatGPT."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Говорите идею как получится: она вставится как чёткий промпт (цель, контекст, шаги, ограничения, критерии готовности) для Claude Code, Cursor или ChatGPT."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พูดความคิดของคุณได้ตามสบาย ระบบจะจัดเป็นพรอมป์ต์ที่ชัดเจนพร้อมเป้าหมาย บริบท ขั้นตอน และข้อกำหนด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fikrini aklına geldiği gibi anlat: Claude Code, Cursor veya ChatGPT için hazır, açık bir istem olarak yapıştırılır (hedef, bağlam, adımlar, kısıtlar ve tamamlanma ölçütleri)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随口说出你的想法：粘贴出来的是清晰的提示词（目标、背景、步骤、约束、完成标准），可直接用于 Claude Code、Cursor 或 ChatGPT。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用自己的方式說出想法，貼上時會整理成清楚的提示詞（目標、背景、步驟、限制、完成條件），可直接用於 Claude Code、Cursor 或 ChatGPT。"
          }
        }
      }
    },
