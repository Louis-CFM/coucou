    },
    "hub.insights-sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما أمليته، وبأي سرعة، وأين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি কী বলেছেন, কত দ্রুত, আর কোথায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du diktiert hast, wie schnell und wo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you dictated, how fast, and where."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que dictaste, a qué velocidad y dónde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que tu as dicté, à quelle vitesse, et où."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने क्या बोला, कितनी तेज़ी से, और कहाँ।"
