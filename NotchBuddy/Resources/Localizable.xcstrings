    "plan.card.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطة Claude"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude প্ল্যান"
          }
        },
