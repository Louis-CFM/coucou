    "chat.local.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بخادم نماذج محلي. لا حاجة لمفتاح API."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি স্থানীয় মডেল সার্ভারে সংযুক্ত হন। কোনো API কী লাগবে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to a local model server. No API key required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a un servidor de modelos local. No se necesita clave API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi à un serveur de modèles local. Aucune clé API requise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक स्थानीय मॉडल सर्वर से कनेक्ट करें। कोई API कुंजी की आवश्यकता नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan ke server model lokal. Tidak perlu kunci API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se a um servidor de modelos local. Não é necessária chave de API."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключись к локальному серверу моделей. API-ключ не нужен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到本地模型服务器。无需 API 密钥。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 모델 서버에 연결합니다. API 키가 필요하지 않습니다."
          }
        }
      }
    },
