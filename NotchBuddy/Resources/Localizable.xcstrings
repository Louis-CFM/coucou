          "stringUnit": {
            "state": "translated",
            "value": "Hooks outdated — update them to answer Claude's questions from the notch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks desactualizados — actualízalos para responder las preguntas de Claude desde el notch"
