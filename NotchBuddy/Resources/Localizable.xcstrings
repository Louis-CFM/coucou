    "hub.replacements-sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يسمع Coucou الكلمات على اليسار، يكتب الكلمات على اليمين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাঁ দিকের শব্দ শুনলে Coucou ডান দিকের শব্দ লেখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Coucou die Wörter links hört, schreibt es die Wörter rechts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When Coucou hears the words on the left, it writes the ones on the right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando Coucou oye las palabras de la izquierda, escribe las de la derecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand Coucou entend les mots de gauche, il écrit ceux de droite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब Coucou बाईं ओर के शब्द सुनता है, तो दाईं ओर के शब्द लिखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Coucou mendengar kata di kiri, ia menulis kata di kanan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
