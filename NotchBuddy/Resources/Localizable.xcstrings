    "voice.setting-speak-desc" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ كوكو النتائج باللغة المنطوقة باستخدام صوت مُركَّب. كل شيء يتم على الجهاز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou কথ্য ভাষায় ফলাফল পড়ে। সবকিছু ডিভাইসেই হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou liest Ergebnisse in der gesprochenen Sprache mit einer synthetischen Stimme vor. Vollständig auf dem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou reads back results in the spoken language, using a synthesized voice. 100% on-device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou lee los resultados en el idioma hablado con una voz sintetizada. Todo en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou lit les résultats dans la langue parlée. Tout se passe sur l'appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou बोली जाने वाली भाषा में परिणाम पढ़ता है। सब कुछ डिवाइस पर।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou membaca hasil dalam bahasa yang diucapkan. Semuanya di perangkat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou lê os resultados no idioma falado. Tudo no dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou зачитывает результаты на языке команды. Всё на устройстве."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou อ่านผลลัพธ์เป็นภาษาที่พูด โดยใช้เสียงสังเคราะห์ ทำงานบนอุปกรณ์ทั้งหมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou sonuçları konuşulan dilde, sentezlenmiş bir sesle okur. Tamamen cihazda çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou 用语音语言朗读结果。完全在设备上处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou 會使用合成語音，以你說話的語言朗讀結果。完全在裝置上執行。"
          }
        }
      }
    },
