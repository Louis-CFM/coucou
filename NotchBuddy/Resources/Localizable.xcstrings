    "flow.ann.mic" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يسمعك Coucou: الميكروفون غير مسموح به أو غير متاح."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou আপনাকে শুনতে পাচ্ছে না: মাইক্রোফোনের অনুমতি নেই বা পাওয়া যাচ্ছে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou kann dich nicht hören: Das Mikrofon ist nicht erlaubt oder nicht verfügbar."
