    "notes.engine-detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مع Claude يُرسل النص المكتوب (وليس الصوت أبدًا) إلى Anthropic بمفتاحك من الإعدادات ← الدردشة. أما Apple Intelligence فيكتبه على جهاز Mac (macOS 26)."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude-এর সঙ্গে ট্রান্সক্রিপ্ট (কখনো অডিও নয়) সেটিংস → চ্যাট-এর কী দিয়ে Anthropic-এ যায়। Apple Intelligence এটি আপনার Mac-এ লেখে (macOS 26)।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Claude wird das Transkript mit deinem Schlüssel aus Einstellungen → Chat an Anthropic gesendet, niemals das Audio. Apple Intelligence erstellt die Zusammenfassung auf deinem Mac (macOS 26)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Claude, the transcript (never the audio) goes to Anthropic with your key from Settings → Chat. Apple Intelligence writes it on your Mac (macOS 26)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Claude, la transcripción (nunca el audio) va a Anthropic con tu clave de Ajustes → Chat. Apple Intelligence lo escribe en tu Mac (macOS 26)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Claude, la transcription (jamais l'audio) part chez Anthropic avec ta clé de Réglages → Chat. Apple Intelligence l'écrit sur ton Mac (macOS 26)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude के साथ ट्रांसक्रिप्ट (ऑडियो कभी नहीं) सेटिंग्स → चैट वाली आपकी कुंजी से Anthropic को जाता है। Apple Intelligence इसे आपके Mac पर लिखता है (macOS 26)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan Claude, transkrip (bukan audio) dikirim ke Anthropic dengan kuncimu dari Pengaturan → Obrolan. Apple Intelligence menulisnya di Mac-mu (macOS 26)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o Claude, a transcrição (nunca o áudio) vai para a Anthropic com sua chave de Ajustes → Chat. A Apple Intelligence escreve no seu Mac (macOS 26)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С Claude расшифровка (но не аудио) уходит в Anthropic с вашим ключом из Настройки → Чат. Apple Intelligence пишет итог прямо на Mac (macOS 26)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อใช้ Claude ระบบจะส่งข้อความถอดเสียง (ไม่ใช่เสียง) ไปยัง Anthropic ด้วยคีย์ของคุณจาก การตั้งค่า → แชต ส่วน Apple Intelligence จะเขียนสรุปบน Mac (macOS 26)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude ile döküm, Ayarlar → Sohbet bölümündeki anahtarınla Anthropic'e gönderilir; ses asla gönderilmez. Apple Intelligence özeti Mac'inde yazar (macOS 26)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Claude 时，转写文字（绝不是音频）会用“设置”→“聊天”中的密钥发送给 Anthropic。Apple 智能则在你的 Mac 上生成（macOS 26）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Claude 時，會透過「設定 → 聊天」中的金鑰將逐字稿傳送至 Anthropic，不會傳送音訊。Apple Intelligence 則會在 Mac 上產生摘要（macOS 26）。"
          }
        }
      }
    },
