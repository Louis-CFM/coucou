    "hub.settings.handsfree-detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مرتين، وتحدّث كما تشاء، ثم اضغط مرة للصق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দুবার চাপুন, যতক্ষণ খুশি বলুন, পেস্ট করতে একবার চাপুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zweimal drücken, beliebig lange sprechen, einmal drücken zum Einfügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap twice, speak as long as you like, tap once to paste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa dos veces, habla lo que quieras y pulsa una vez para pegar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tape deux fois, parle aussi longtemps que tu veux, tape une fois pour coller."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दो बार दबाएँ, जितना चाहें बोलें, चिपकाने के लिए एक बार दबाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk dua kali, bicara sepuasnya, ketuk sekali untuk menempel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes, fale o quanto quiser, toque uma vez para colar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите дважды, говорите сколько угодно, нажмите один раз, чтобы вставить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะสองครั้งแล้วพูดได้นานตามต้องการ แตะหนึ่งครั้งเพื่อวางข้อความ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki kez bas, istediğin kadar konuş, yapıştırmak için bir kez bas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连按两次，想说多久就说多久，再按一次即粘贴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連按兩下後即可持續說話，再按一下即可貼上。"
          }
        }
      }
