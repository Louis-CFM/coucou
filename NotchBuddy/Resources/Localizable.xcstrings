    "whatsnew.thanks" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou مجاني ومفتوح المصدر. إن وفّر عليك الوقت، يمكنك دعوة Mochi إلى قهوة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou বিনামূল্যে ও ওপেন সোর্স। এটি আপনার সময় বাঁচালে Mochi-কে এক কাপ কফি খাওয়াতে পারেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou ist kostenlos und Open Source. Wenn es dir Zeit spart, kannst du Mochi einen Kaffee spendieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou is free and open source. If it saves you time, you can buy Mochi a coffee."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou es gratis y de código abierto. Si te ahorra tiempo, puedes invitar a Mochi a un café."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou est gratuit et open source. S’il te fait gagner du temps, tu peux offrir un café à Mochi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou मुफ़्त और ओपन सोर्स है। अगर यह आपका समय बचाता है, तो Mochi को एक कॉफ़ी पिला सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou gratis dan open source. Kalau ini menghemat waktumu, kamu bisa traktir Mochi kopi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Coucou é gratuito e de código aberto. Se ele economiza seu tempo, você pode pagar um café para o Mochi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou бесплатный и с открытым кодом. Если он экономит вам время, можно угостить Mochi кофе."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou ใช้ฟรีและเป็นโอเพนซอร์ส ถ้าช่วยประหยัดเวลาคุณ เลี้ยงกาแฟ Mochi สักแก้วได้นะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou ücretsiz ve açık kaynak. Sana zaman kazandırıyorsa Mochi’ye bir kahve ısmarlayabilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou 免费且开源。如果它帮你节省了时间，可以请 Mochi 喝杯咖啡。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou 免費且開源。如果它幫你節省了時間，可以請 Mochi 喝杯咖啡。"
          }
        }
      }
    },
