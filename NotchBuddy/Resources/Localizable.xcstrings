    "chat.vertex.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم بيانات اعتماد gcloud الافتراضية للتطبيقات. عند تعيين مشروع، يستخدمه Claude وGemini بدلاً من مفاتيح API أدناه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার gcloud Application Default Credentials ব্যবহার করে। প্রজেক্ট সেট থাকলে Claude ও Gemini নিচের API কীর বদলে সেটি ব্যবহার করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses your gcloud Application Default Credentials. When a project is set, Claude and Gemini use it instead of the API keys below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tus credenciales predeterminadas de aplicación de gcloud. Con un proyecto definido, Claude y Gemini lo usan en lugar de las claves de API de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise vos identifiants par défaut gcloud (Application Default Credentials). Quand un projet est défini, Claude et Gemini l’utilisent à la place des clés API ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके gcloud Application Default Credentials का उपयोग करता है। प्रोजेक्ट सेट होने पर Claude और Gemini नीचे दी गई API कुंजियों की जगह उसका उपयोग करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memakai Application Default Credentials gcloud Anda. Jika proyek diatur, Claude dan Gemini memakainya alih-alih kunci API di bawah."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa suas credenciais padrão de aplicativo do gcloud. Com um projeto definido, Claude e Gemini o usam no lugar das chaves de API abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует учётные данные gcloud Application Default Credentials. Если проект задан, Claude и Gemini используют его вместо API-ключей ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的 gcloud 应用默认凭据。设置项目后，Claude 和 Gemini 将通过它访问，而不是使用下面的 API 密钥。"
          }
        }
      }
    },
    "chat.vertex.help.no-credentials": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل أولاً gcloud auth application-default login، ثم عيّن المشروع. سيستخدمه Claude وGemini بدلاً من مفاتيح API أدناه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথমে gcloud auth application-default login চালান, তারপর প্রজেক্ট সেট করুন। Claude ও Gemini নিচের API কীর বদলে সেটি ব্যবহার করবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run gcloud auth application-default login first, then set the project. Claude and Gemini will use it instead of the API keys below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta primero gcloud auth application-default login y luego define el proyecto. Claude y Gemini lo usarán en lugar de las claves de API de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez d’abord gcloud auth application-default login, puis indiquez le projet. Claude et Gemini l’utiliseront à la place des clés API ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले gcloud auth application-default login चलाएँ, फिर प्रोजेक्ट सेट करें। Claude और Gemini नीचे दी गई API कुंजियों की जगह उसका उपयोग करेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan dulu gcloud auth application-default login, lalu atur proyeknya. Claude dan Gemini akan memakainya alih-alih kunci API di bawah."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute primeiro gcloud auth application-default login e depois defina o projeto. Claude e Gemini vão usá-lo no lugar das chaves de API abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выполните gcloud auth application-default login, затем укажите проект. Claude и Gemini будут использовать его вместо API-ключей ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先运行 gcloud auth application-default login，然后设置项目。Claude 和 Gemini 将通过它访问，而不是使用下面的 API 密钥。"
          }
        }
      }
    },
