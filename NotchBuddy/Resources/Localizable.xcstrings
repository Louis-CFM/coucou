    "capture.flow-hint %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على %@ وتحدث: تذهب الصورة وكلماتك معًا."
