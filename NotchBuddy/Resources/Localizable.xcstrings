    "whatsapp.webhook.port-busy %lld" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المنفذ %lld مستخدم: اختر منفذًا آخر. في الأثناء يتم التحقق كل 20 ث."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পোর্ট %lld ব্যস্ত: অন্যটি বেছে নিন। ততক্ষণ প্রতি ২০ সেকেন্ডে দেখা হচ্ছে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Port %lld is taken: pick another one. Checking every 20 s meanwhile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El puerto %lld está ocupado: elige otro. Mientras tanto, se comprueba cada 20 s."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le port %lld est déjà pris : choisis-en un autre. Vérification toutes les 20 s en attendant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोर्ट %lld पहले से इस्तेमाल में है: कोई और चुनें। तब तक हर 20 सेकंड में जाँच।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Port %lld sudah dipakai: pilih yang lain. Sementara itu diperiksa setiap 20 dtk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A porta %lld está ocupada: escolha outra. Enquanto isso, verificando a cada 20 s."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порт %lld занят: выберите другой. Пока проверка каждые 20 с."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端口 %lld 已被占用：请换一个。在此期间每 20 秒检查一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連接埠 %lld 已被占用，請另選一個。目前會每 20 秒檢查一次訊息。"
          }
        }
      }
    },
    "whatsapp.webhook.refused %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفضت البوابة عنوان Coucou ‏(%@). يتم التحقق كل 20 ث بدلًا من ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গেটওয়ে Coucou-র ঠিকানা প্রত্যাখ্যান করেছে (%@)। এর বদলে প্রতি ২০ সেকেন্ডে দেখা হচ্ছে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gateway refused Coucou’s address (%@). Checking every 20 s instead."
          }
        },
        "es" : {
          "stringUnit" : {
