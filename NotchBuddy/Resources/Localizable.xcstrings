    "hub.cleanup-detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف «أممم» والتكرار والتصحيحات التي تقولها أثناء الكلام، ويصلح علامات الترقيم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“উম”, পুনরাবৃত্তি আর বলার সময় করা সংশোধন সরিয়ে দেয় এবং যতিচিহ্ন ঠিক করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt „äh“, Wiederholungen und Korrekturen beim Sprechen und verbessert die Zeichensetzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes the “um”, the repeats and the corrections you made while speaking, and fixes the punctuation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita los «eh», las repeticiones y las correcciones que haces al hablar, y arregla la puntuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enlève les « euh », les répétitions et les corrections faites en parlant, et corrige la ponctuation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“अं”, दोहराव और बोलते समय किए गए सुधार हटाता है, और विराम चिह्न ठीक करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus “eh”, pengulangan dan koreksi saat bicara, lalu merapikan tanda baca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tira os “é…”, as repetições e as correções feitas ao falar, e acerta a pontuação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убирает «э-э», повторы и поправки, сделанные на ходу, и исправляет пунктуацию."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบคำอ้ำอึ้ง คำซ้ำ และคำที่แก้ระหว่างพูด พร้อมปรับเครื่องหมายวรรคตอน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşurken söylediğin “ıı” gibi dolgu seslerini, tekrarları ve düzeltmeleri kaldırır; noktalama işaretlerini düzeltir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去掉“嗯”、重复和说话时的改口，并修正标点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除「嗯」、重複及說話時的修正，並修正標點符號。"
          }
        }
      }
    },
    "hub.cleanup-key" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم التنقيح مفتاح Claude الخاص بك. أضفه في الإعدادات ← الدردشة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিষ্কার করতে আপনার Claude কী লাগে। সেটিংস → চ্যাট-এ যোগ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Überarbeitung nutzt deinen Claude-Schlüssel. Füge ihn unter Einstellungen → Chat hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The clean-up uses your Claude key. Add it in Settings → Chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limpieza usa tu clave de Claude. Añádela en Ajustes → Chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nettoyage utilise ta clé Claude. Ajoute-la dans Réglages → Chat."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सफ़ाई आपकी Claude कुंजी से होती है। इसे सेटिंग्स → चैट में जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perapian memakai kunci Claude-mu. Tambahkan di Pengaturan → Obrolan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A limpeza usa sua chave do Claude. Adicione-a em Ajustes → Chat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для чистки нужен ваш ключ Claude. Добавьте его в Настройки → Чат."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การปรับข้อความใช้คีย์ Claude ของคุณ เพิ่มคีย์ได้ที่ การตั้งค่า → แชต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenleme, Claude anahtarını kullanır. Ayarlar → Sohbet bölümünden ekle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整理会使用你的 Claude 密钥。请在“设置”→“聊天”中添加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字整理使用你的 Claude 金鑰。請在「設定 → 聊天」中新增。"
          }
        }
      }
    },
    "hub.cleanup-privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تشغيل التنقيح يُرسل النص (وليس صوتك أبدًا) إلى Anthropic بمفتاح Claude الخاص بك. وعند إيقافه يبقى كل شيء على جهاز Mac."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিষ্কার চালু থাকলে লেখা (কখনো আপনার কণ্ঠ নয়) আপনার Claude কী দিয়ে Anthropic-এ যায়। বন্ধ থাকলে সব আপনার Mac-এই থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei aktivierter Überarbeitung wird der Text mit deinem Claude-Schlüssel an Anthropic gesendet, niemals deine Stimme. Ist sie aus, bleibt alles auf deinem Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With the clean-up on, the text (never your voice) goes to Anthropic with your Claude key. Off, everything stays on your Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la limpieza activada, el texto (nunca tu voz) va a Anthropic con tu clave de Claude. Desactivada, todo se queda en tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec le nettoyage, le texte (jamais ta voix) part chez Anthropic avec ta clé Claude. Sans, tout reste sur ton Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सफ़ाई चालू होने पर टेक्स्ट (आपकी आवाज़ कभी नहीं) आपकी Claude कुंजी के साथ Anthropic को जाता है। बंद होने पर सब कुछ आपके Mac पर रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat perapian aktif, teksnya (bukan suaramu) dikirim ke Anthropic dengan kunci Claude-mu. Saat mati, semuanya tetap di Mac-mu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a limpeza ligada, o texto (nunca sua voz) vai para a Anthropic com sua chave do Claude. Desligada, tudo fica no seu Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда чистка включена, текст (но не голос) уходит в Anthropic с вашим ключом Claude. Когда выключена, всё остаётся на Mac."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้ ระบบจะส่งข้อความ (ไม่ใช่เสียง) ไปยัง Anthropic ด้วยคีย์ Claude ของคุณ เมื่อปิด ทุกอย่างจะอยู่บน Mac"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenleme açıkken metin, Claude anahtarınla Anthropic'e gönderilir; sesin asla gönderilmez. Kapalıyken her şey Mac'inde kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启整理时，文字（绝不是你的声音）会用你的 Claude 密钥发送给 Anthropic。关闭时，一切都留在你的 Mac 上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟文字整理時，會使用你的 Claude 金鑰將文字傳送至 Anthropic，不會傳送語音。關閉時，所有資料都留在 Mac 上。"
          }
        }
      }
    },
