        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके Mac पर गिनी जाती हैं, कहीं भेजी नहीं जातीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
