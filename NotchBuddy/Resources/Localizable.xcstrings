        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No celular: WhatsApp › Configurações › Dispositivos conectados › Conectar dispositivo, e escaneie este código."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На телефоне: WhatsApp › Настройки › Связанные устройства › Привязка устройства, затем отсканируйте этот код."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在手机上：WhatsApp › 设置 › 已关联的设备 › 关联新设备，然后扫描此二维码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在手機上開啟 WhatsApp › 設定 › 已連結裝置 › 連結裝置，然後掃描此 QR 碼。"
          }
        }
      }
    },
