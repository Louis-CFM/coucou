    "Stored locally on your Mac. Nothing leaves your Mac. Retained for 12 weeks.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مخزَّن محليًا على Mac. لا يغادر أي شيء جهازك. يُحتفظ به لمدة 12 أسبوعًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার Mac-এ স্থানীয়ভাবে সংরক্ষিত। কিছু Mac ছেড়ে যায় না। ১২ সপ্তাহ ধরে রাখা হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored locally on your Mac. Nothing leaves your Mac. Retained for 12 weeks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Almacenado localmente en tu Mac. Nada sale de tu Mac. Retenido durante 12 semanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocké localement sur ton Mac. Rien ne quitte ton Mac. Conservé pendant 12 semaines."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Mac पर स्थानीय रूप से संग्रहीत। कुछ भी Mac नहीं छोड़ता। 12 सप्ताह तक रखा जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan secara lokal di Mac. Tidak ada yang keluar dari Mac Anda. Disimpan selama 12 minggu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Armazenado localmente no seu Mac. Nada sai do seu Mac. Mantido por 12 semanas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранится локально на Mac. Ничего не покидает Mac. Хранится 12 недель."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "储存在 Mac 本地，不会离开你的 Mac，保留 12 周。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 로컬로 저장됩니다. 어떤 데이터도 Mac 외부로 나가지 않습니다. 12주 동안 보관됩니다."
          }
        }
      }
    },
