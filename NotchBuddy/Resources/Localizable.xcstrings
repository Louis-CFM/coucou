      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكامل غير رسمي: يمرّ عبر بوابة تشغّلها على هذا الـMac. استخدمه على حسابك فقط. قد يقيّد واتساب الحسابات عند إساءة الاستخدام."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনানুষ্ঠানিক ইন্টিগ্রেশন: এটি এই Mac-এ চালানো একটি গেটওয়ে দিয়ে কাজ করে। শুধু নিজের অ্যাকাউন্টে ব্যবহার করুন। অপব্যবহারে WhatsApp অ্যাকাউন্ট সীমিত করতে পারে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unofficial integration: it goes through a gateway you run on this Mac. Use it on your own account only. WhatsApp may restrict accounts that abuse it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integración no oficial: pasa por una pasarela que ejecutas en este Mac. Úsala solo con tu propia cuenta. WhatsApp puede restringir las cuentas que abusen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intégration non officielle : elle passe par une passerelle que tu lances sur ce Mac. À utiliser sur ton propre compte uniquement. WhatsApp peut restreindre un compte en cas d’abus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनौपचारिक इंटीग्रेशन: यह इस Mac पर चल रहे गेटवे से होकर काम करता है। सिर्फ़ अपने अकाउंट पर इस्तेमाल करें। दुरुपयोग पर WhatsApp अकाउंट सीमित कर सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrasi tidak resmi: berjalan lewat gateway yang kamu jalankan di Mac ini. Gunakan hanya di akunmu sendiri. WhatsApp bisa membatasi akun yang menyalahgunakannya."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integração não oficial: passa por um gateway que você executa neste Mac. Use só na sua própria conta. O WhatsApp pode restringir contas em caso de abuso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неофициальная интеграция: работает через шлюз, запущенный на этом Mac. Используйте только со своим аккаунтом. WhatsApp может ограничить аккаунт при злоупотреблении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非官方集成：通过你在这台 Mac 上运行的网关工作。仅限用于你自己的账号。滥用时 WhatsApp 可能会限制账号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非官方整合：透過這台 Mac 上執行的閘道連線，請僅用於自己的帳號。WhatsApp 可能限制濫用此功能的帳號。"
          }
        }
      }
    },
