    "status.local.unreachable %1$@ %2$@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذَّر الوصول إلى %1$@ على %2$@. هل هو قيد التشغيل؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ কে %2$@ তে পৌঁছানো যাচ্ছে না। এটি কি চলছে?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach %1$@ at %2$@. Is it running?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con %1$@ en %2$@. ¿Está en ejecución?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'atteindre %1$@ sur %2$@. Est-il en cours d'exécution ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ को %2$@ पर नहीं पहुंचा जा सका। क्या यह चल रहा है?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menjangkau %1$@ di %2$@. Apakah sedang berjalan?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar %1$@ em %2$@. Ele está em execução?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться к %1$@ по адресу %2$@. Он запущен?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问 %1$@（%2$@）。它正在运行吗？"
          }
        }
      }
    },
