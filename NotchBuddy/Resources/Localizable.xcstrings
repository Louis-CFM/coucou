    "portfolio.hint" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصول للقراءة فقط. المفاتيح في Keychain، لا تُرسل أبداً."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু পড়ার অ্যাক্সেস। কীগুলি কীচেইনে, কোথাও পাঠানো হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Lesezugriff. Schlüssel im Keychain, werden nirgendwo gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read-only access only. Keys stored in the Keychain, never sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo acceso de lectura. Claves en Keychain, nunca enviadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès en lecture seule. Clés dans le Trousseau, jamais envoyées ailleurs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल पढ़ने की पहुंच। कीज़ Keychain में, कहीं नहीं भेजी जातीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses baca saja. Kunci disimpan di Keychain, tidak dikirim ke mana pun."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente leitura. Chaves no Keychain, nunca enviadas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิทธิ์อ่านอย่างเดียว เก็บคีย์ไว้ใน Keychain และไม่ส่งไปที่อื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca salt okunur erişim. Anahtarlar Anahtar Zinciri'nde saklanır, hiçbir yere gönderilmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅读取权限。密钥存储在 Keychain，不会发送到任何地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅提供唯讀存取。金鑰儲存在鑰匙圈中，不會傳送到其他地方。"
          }
        }
      }
    },
    "portfolio.instructions.binance" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle unter Binance → API Management einen Schlüssel nur mit der Berechtigung Read Info. Aktiviere weder Spot Trading noch Withdrawals."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Binance → API Management, create a key with Read Info permission only. Do not enable Spot Trading or Withdrawals."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Binance → Gestion des API, créez une clé avec la permission Lire uniquement. N'activez pas le trading ni les retraits."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใน Binance → API Management สร้างคีย์ที่มีสิทธิ์อ่านข้อมูลเท่านั้น อย่าเปิด Spot Trading หรือ Withdrawals"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binance → API Yönetimi bölümünde yalnızca Read Info izni olan bir anahtar oluştur. Spot Trading veya Withdrawals izinlerini açma."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Binance → API 管理中建立金鑰，僅啟用「讀取資訊」權限。請勿啟用現貨交易或提款。"
          }
        }
      }
    },
