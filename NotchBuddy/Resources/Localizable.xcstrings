    "demo.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore all features without an API key or Claude Code. Nothing is written to disk."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استكشف جميع الميزات بدون مفتاح API أو Claude Code. لا يُكتب شيء على القرص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "API কী বা Claude Code ছাড়াই সমস্ত ফিচার এক্সপ্লোর করুন। ডিস্কে কিছু লেখা হয় না।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora todas las funciones sin clave de API ni Claude Code. Nada se escribe en el disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore toutes les fonctions sans clé d'API ni Claude Code. Rien n'est écrit sur le disque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "API कुंजी या Claude Code के बिना सभी सुविधाएँ एक्सप्लोर करें। डिस्क पर कुछ नहीं लिखा जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelajahi semua fitur tanpa kunci API atau Claude Code. Tidak ada yang ditulis ke disk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore todos os recursos sem chave de API ou Claude Code. Nada é gravado no disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изучи все функции без API-ключа и Claude Code. Ничего не записывается на диск."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需 API 密钥或 Claude Code，探索所有功能。不会写入任何内容到磁盘。"
          }
        }
      }
    },
