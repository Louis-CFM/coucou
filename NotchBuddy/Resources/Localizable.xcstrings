          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes de aprobación las gestiona Hermes (terminal o gateway)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes d'approbation sont gérées par Hermes (terminal ou passerelle)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमोदन अनुरोध Hermes द्वारा संभाले जाते हैं (टर्मिनल या गेटवे)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan persetujuan ditangani oleh Hermes (terminal atau gateway)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitações de aprovação tratadas pelo Hermes (terminal ou gateway)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросы подтверждения обрабатывает Hermes (терминал или шлюз)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
