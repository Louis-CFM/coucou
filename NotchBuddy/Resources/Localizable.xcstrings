    "hub.snippets-empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا مقتطفات بعد. رابط حجز المواعيد، توقيعك، عنوانك: قل بضع كلمات واحصل على النص كاملًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনো কোনো স্নিপেট নেই। আপনার বুকিং লিংক, স্বাক্ষর, ঠিকানা: কয়েকটি শব্দ বলুন, পুরো লেখা পান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Textbausteine. Dein Buchungslink, deine Signatur, deine Adresse: Sage ein paar Wörter und erhalte den ganzen Text."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No snippet yet. Your booking link, your signature, your address: say a few words, get the whole text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay fragmentos. Tu enlace de citas, tu firma, tu dirección: di unas palabras y obtén el texto entero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore de snippet. Ton lien de rendez-vous, ta signature, ton adresse : dis quelques mots, reçois le texte entier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी कोई स्निपेट नहीं। आपका बुकिंग लिंक, हस्ताक्षर, पता: कुछ शब्द बोलें, पूरा टेक्स्ट पाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada cuplikan. Tautan jadwalmu, tanda tanganmu, alamatmu: ucapkan beberapa kata, dapatkan teks utuhnya."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum trecho ainda. Seu link de agendamento, sua assinatura, seu endereço: diga poucas palavras e receba o texto inteiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаблонов пока нет. Ссылка для записи, подпись, адрес: скажите пару слов — получите весь текст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีข้อความสำเร็จรูป เช่น ลิงก์นัดหมาย ลายเซ็น หรือที่อยู่ พูดคำสั้น ๆ แล้วแทรกข้อความทั้งหมดได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz metin kısayolu yok. Rezervasyon bağlantın, imzan, adresin: birkaç sözcük söyle, tüm metni al."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有片段。你的预约链接、签名、地址：说几个字，就能得到整段文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚無文字片段。預約連結、簽名檔、地址：只要說出幾個字，就能貼上完整內容。"
          }
        }
      }
    },
    "hub.snippets-sub" : {
