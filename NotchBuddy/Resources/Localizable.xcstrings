    "whatsapp.focus-unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يسمح macOS بعد لهذا الإصدار من Coucou بقراءة حالة التركيز: تستمر الرسائل في الوصول ويستمر Mochi في التفاعل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS এখনও Coucou-র এই বিল্ডকে ফোকাসের অবস্থা পড়তে দেয় না: বার্তা আসতে থাকবে, Mochi সাড়া দিতে থাকবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS doesn’t let this build of Coucou read the Focus state yet: messages still arrive, Mochi keeps reacting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS aún no deja a esta versión de Coucou leer el estado de Concentración: los mensajes siguen llegando y Mochi sigue reaccionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ne laisse pas encore cette version de Coucou lire l’état Concentration : les messages arrivent quand même, Mochi continue de réagir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS अभी Coucou के इस बिल्ड को फ़ोकस की स्थिति पढ़ने नहीं देता: संदेश आते रहेंगे, Mochi प्रतिक्रिया देता रहेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS belum mengizinkan build Coucou ini membaca status Fokus: pesan tetap masuk, Mochi tetap bereaksi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS ainda não deixa esta versão do Coucou ler o estado do Foco: as mensagens continuam chegando e o Mochi continua reagindo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS пока не даёт этой сборке Coucou читать состояние фокусирования: сообщения приходят, Mochi реагирует."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 暂不允许此版本的 Coucou 读取专注状态：消息仍会到达，Mochi 仍会做出反应。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 尚未允許此版本的 Coucou 讀取專注模式狀態，仍會收到訊息，Mochi 也會繼續回應。"
          }
        }
      }
    },
