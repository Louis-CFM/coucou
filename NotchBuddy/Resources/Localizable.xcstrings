    "notes.transcript-hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلمة خاطئة أو شخص خاطئ؟ صحّحها من قائمة ⋯ في السطر. تُحفظ الكلمات التي تصححها لمكالماتك القادمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভুল শব্দ, নাকি ভুল ব্যক্তি? লাইনের ⋯ মেনু থেকে ঠিক করুন। আপনি যে শব্দ ঠিক করেন, তা পরের কলগুলোর জন্য মনে রাখা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein falsches Wort oder die falsche Person? Korrigiere es über das ⋯-Menü der Zeile. Wörter, die du korrigierst, werden für deine nächsten Gespräche gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A wrong word, or the wrong person? Fix it from the line's ⋯ menu. Words you correct are remembered for your next calls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Una palabra mal o la persona equivocada? Corrígelo desde el menú ⋯ de la línea. Las palabras que corriges se recuerdan para tus próximas llamadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mot faux, ou la mauvaise personne ? Corrige-le depuis le menu ⋯ de la ligne. Les mots que tu corriges sont retenus pour tes prochains appels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई शब्द गलत है, या व्यक्ति गलत? पंक्ति के ⋯ मेनू से ठीक करें। आप जो शब्द सुधारते हैं, वे अगली कॉल के लिए याद रखे जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata yang salah, atau orang yang salah? Perbaiki dari menu ⋯ di baris itu. Kata yang kamu perbaiki diingat untuk panggilan berikutnya."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma palavra errada ou a pessoa errada? Corrija pelo menu ⋯ da linha. As palavras que você corrige ficam guardadas para as próximas chamadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неверное слово или не тот человек? Исправьте через меню ⋯ строки. Исправленные слова запоминаются для следующих звонков."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำผิดหรือระบุผู้พูดผิดใช่ไหม แก้ไขได้จากเมนู ⋯ ของบรรทัด คำที่แก้ไขจะถูกจดจำไว้สำหรับครั้งต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanlış bir sözcük veya yanlış bir kişi mi? Satırın ⋯ menüsünden düzelt. Düzelttiğin sözcükler sonraki görüşmelerin için hatırlanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "词听错了，或说话人不对？在该行的 ⋯ 菜单里修改。你改正的词会被记住，用于之后的通话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詞彙或發言者有誤？請從該行的 ⋯ 選單修正。修正過的詞彙會被記住，供之後通話使用。"
          }
        }
      }
    },
