    "Choose the tools you use. Coucou only shows what you declare here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الأدوات التي تستخدمها. يعرض Coucou فقط ما تُعلنه هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যে টুলগুলো ব্যবহার করেন তা বেছে নিন। Coucou শুধুমাত্র আপনার ঘোষণা করা জিনিস দেখায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the tools you use. Coucou only shows what you declare here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las herramientas que usas. Coucou solo muestra lo que declares aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis les outils que tu utilises. Coucou n'affiche que ce que tu déclares ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे टूल चुनें जो आप उपयोग करते हैं। Coucou केवल वही दिखाता है जो आप यहाँ घोषित करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih alat yang Anda gunakan. Coucou hanya menampilkan yang Anda deklarasikan di sini."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha as ferramentas que você usa. O Coucou mostra apenas o que você declarar aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери инструменты, которые ты используешь. Coucou показывает только то, что ты здесь объявишь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你使用的工具。Coucou 只显示你在这里声明的内容。"
          }
        }
      }
    },
