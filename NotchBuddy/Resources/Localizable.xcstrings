    "voice.setting-speak": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كوكو يرد بصوت عالٍ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou জোরে জবাব দেয়"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou responds aloud"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou responde en voz alta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou répond à voix haute"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou ज़ोर से जवाब देता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou merespons dengan suara"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou responde em voz alta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou отвечает вслух"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou 大声回应"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou가 음성으로 응답"
          }
        }
      }
    },
    "voice.setting-speak-desc": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ كوكو النتائج باللغة المنطوقة باستخدام صوت مُركَّب. كل شيء يتم على الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou কথ্য ভাষায় ফলাফল পড়ে। সবকিছু ডিভাইসেই হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou reads back results in the spoken language, using a synthesized voice. 100% on-device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou lee los resultados en el idioma hablado con una voz sintetizada. Todo en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou lit les résultats dans la langue parlée. Tout se passe sur l'appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou बोली जाने वाली भाषा में परिणाम पढ़ता है। सब कुछ डिवाइस पर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou membaca hasil dalam bahasa yang diucapkan. Semuanya di perangkat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou lê os resultados no idioma falado. Tudo no dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou зачитывает результаты на языке команды. Всё на устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou 用语音语言朗读结果。完全在设备上处理。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou가 합성된 음성을 사용하여 말한 언어로 결과를 읽어줍니다. 100% 기기 내에서 처리됩니다."
          }
        }
      }
    },
