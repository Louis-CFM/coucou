          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считается на вашем Mac и никуда не отправляется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นับข้อมูลบน Mac ของคุณและไม่ส่งไปที่ใด"
          }
        },
        "tr" : {
          "stringUnit" : {
