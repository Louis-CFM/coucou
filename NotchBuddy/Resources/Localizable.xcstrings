    "hub.settings.privacy-text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى السجل والإحصاءات وملاحظاتك على جهاز Mac هذا، في مجلد Coucou. لا تُحفظ الإملاءات صوتيًا أبدًا، ويُحذف صوت المكالمة فور كتابة نصها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইতিহাস, পরিসংখ্যান আর আপনার নোট এই Mac-এ, Coucou-র ফোল্ডারে থাকে। ডিক্টেশন কখনো অডিও হিসেবে রাখা হয় না; কলের অডিও ট্রান্সক্রিপ্ট লেখা হলেই মুছে ফেলা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlauf, Statistik und Notizen bleiben auf diesem Mac im Coucou-Ordner. Diktate werden nie als Audio gespeichert; die Gesprächsaufnahme wird gelöscht, sobald das Transkript geschrieben ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The history, the statistics and your notes stay on this Mac, in Coucou's folder. Dictations are never saved as audio; a call's audio is deleted as soon as its transcript is written."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial, las estadísticas y tus notas se quedan en este Mac, en la carpeta de Coucou. Los dictados nunca se guardan como audio; el audio de una llamada se borra en cuanto se escribe su transcripción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'historique, les statistiques et tes notes restent sur ce Mac, dans le dossier de Coucou. Les dictées ne sont jamais gardées en audio ; l'audio d'un call est effacé dès que sa transcription est écrite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इतिहास, आँकड़े और आपके नोट्स इसी Mac पर, Coucou के फ़ोल्डर में रहते हैं। डिक्टेशन कभी ऑडियो के रूप में नहीं रखे जाते; कॉल का ऑडियो ट्रांसक्रिप्ट लिखते ही मिटा दिया जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riwayat, statistik, dan catatanmu tetap di Mac ini, di folder Coucou. Dikte tidak pernah disimpan sebagai audio; audio panggilan dihapus begitu transkripnya selesai ditulis."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O histórico, as estatísticas e suas notas ficam neste Mac, na pasta do Coucou. Os ditados nunca são guardados em áudio; o áudio de uma chamada é apagado assim que a transcrição é escrita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История, статистика и заметки хранятся на этом Mac, в папке Coucou. Диктовки никогда не сохраняются как аудио; запись звонка удаляется, как только готова расшифровка."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประวัติ สถิติ และบันทึกของคุณอยู่บน Mac เครื่องนี้ในโฟลเดอร์ Coucou ไม่มีการบันทึกเสียงการป้อนตามคำบอก และเสียงการโทรจะถูกลบทันทีที่เขียนข้อความถอดเสียงเสร็จ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmiş, istatistikler ve notların bu Mac'te, Coucou klasöründe kalır. Dikteler asla ses olarak kaydedilmez; görüşmenin sesi, dökümü yazılır yazılmaz silinir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "历史记录、统计和你的笔记都保存在这台 Mac 上的 Coucou 文件夹中。听写从不保存为音频；通话的音频在转写完成后立即删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歷史紀錄、統計資料與筆記會保存在此 Mac 的 Coucou 資料夾中。聽寫不會儲存為音訊；通話音訊會在逐字稿完成後立即刪除。"
          }
        }
      }
    },
