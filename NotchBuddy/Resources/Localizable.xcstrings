        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हुक पुराने हैं — नॉच से Claude के सवालों का जवाब देने के लिए अपडेट करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks usang — perbarui untuk menjawab pertanyaan Claude dari notch"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks desatualizados — atualize-os para responder às perguntas do Claude pelo notch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
