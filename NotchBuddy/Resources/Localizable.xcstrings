    "hub.hint %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على %@ في أي مكان، تحدّث، ثم اترك: يُلصق النص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেকোনো জায়গায় %@ চেপে ধরুন, বলুন, ছেড়ে দিন: পেস্ট হয়ে যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte überall %@ gedrückt, sprich und lasse los: Der Text wird eingefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold %@ anywhere, speak, let go: it's pasted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén %@ en cualquier sitio, habla y suelta: queda pegado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintiens %@ n'importe où, parle, relâche : c'est collé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कहीं भी %@ दबाए रखें, बोलें, छोड़ दें: टेक्स्ट चिपक जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan %@ di mana saja, bicara, lepas: langsung ditempel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure %@ em qualquer lugar, fale e solte: está colado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте %@ где угодно, говорите, отпустите — текст вставлен."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กด %@ ค้างไว้ที่ใดก็ได้ พูด แล้วปล่อย ระบบจะวางข้อความให้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her yerde %@ tuşunu basılı tut, konuş, bırak: metin yapıştırılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何地方按住 %@，说话，松开：文字就粘贴好了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何地方按住 %@ 說話，放開即可貼上文字。"
          }
        }
      }
    },
