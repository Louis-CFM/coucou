    "plugin.hermes.approvals.disabled": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعالج Hermes طلبات الموافقة (الطرفية أو البوابة)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes অনুমোদন অনুরোধ পরিচালনা করে (টার্মিনাল বা গেটওয়ে)।"
          }
        },
        "en": {
