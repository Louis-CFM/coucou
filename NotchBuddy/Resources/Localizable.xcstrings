    "Hovering the island opens it; it folds again shortly after the pointer leaves. Click inside to keep it open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح التمرير فوق الجزيرة ويُطوى بعد مغادرة المؤشر بقليل. انقر داخلها لإبقائها مفتوحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আইল্যান্ডের উপর পয়েন্টার রাখলে খোলে; পয়েন্টার সরালে একটু পরে আবার গুটিয়ে যায়। খোলা রাখতে ভিতরে ক্লিক করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovering the island opens it; it folds again shortly after the pointer leaves. Click inside to keep it open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar el cursor por la isla la abre; se pliega poco después de que el cursor salga. Haz clic dentro para dejarla abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survoler l'île l'ouvre ; elle se replie peu après que le pointeur la quitte. Cliquez dedans pour la garder ouverte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आइलैंड पर पॉइंटर ले जाने से वह खुलता है; पॉइंटर हटने के कुछ देर बाद फिर सिमट जाता है। खुला रखने के लिए अंदर क्लिक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengarahkan kursor ke pulau akan membukanya; pulau menutup lagi sesaat setelah kursor pergi. Klik di dalamnya agar tetap terbuka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar o cursor pela ilha a abre; ela se fecha logo depois que o cursor sai. Clique dentro para mantê-la aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведение открывает остров; он сворачивается вскоре после того, как указатель уходит. Щёлкните внутри, чтобы он остался открытым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针悬停在岛上即可打开；指针离开后不久会再次收起。在其中点按可保持打开。"
          }
        }
      }
    },
