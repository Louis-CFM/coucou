    "hub.words-empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا كلمات بعد. أضف الأسماء والعلامات والمصطلحات التي يخطئ Coucou في كتابتها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনো কোনো শব্দ নেই। যে নাম, ব্র্যান্ড আর পরিভাষা Coucou ভুল লেখে সেগুলো যোগ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Wörter. Füge Namen, Marken und Fachbegriffe hinzu, die Coucou falsch schreibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No word yet. Add the names, brands and jargon Coucou gets wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay palabras. Añade los nombres, marcas y tecnicismos que Coucou escribe mal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun mot pour l'instant. Ajoute les noms, marques et mots techniques que Coucou écrit mal."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी कोई शब्द नहीं। वे नाम, ब्रांड और तकनीकी शब्द जोड़ें जिन्हें Coucou गलत लिखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada kata. Tambahkan nama, merek, dan istilah yang sering salah ditulis Coucou."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma palavra ainda. Adicione nomes, marcas e termos técnicos que o Coucou escreve errado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слов пока нет. Добавьте имена, бренды и термины, которые Coucou пишет неправильно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีคำ เพิ่มชื่อ แบรนด์ และศัพท์เฉพาะที่ Coucou มักฟังผิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz sözcük yok. Coucou'nun yanlış yazdığı adları, markaları ve terimleri ekle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有词语。添加 Coucou 写错的名字、品牌和术语。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚無詞彙。新增 Coucou 容易辨識錯誤的名稱、品牌與專有名詞。"
          }
        }
      }
