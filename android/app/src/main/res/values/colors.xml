<?xml version="1.0" encoding="utf-8"?>
<!-- Widgets: dark by default; values-notnight/colors.xml is the light variant that follows the system day/night mode. -->
<resources>
    <color name="widget_card">#FF17181C</color>
    <color name="widget_border">#FF3A3C44</color>
    <color name="widget_text">#FFFFFFFF</color>
    <color name="widget_text_soft">#D9FFFFFF</color>
    <color name="widget_text_secondary">#B3FFFFFF</color>
    <!-- The lighter circle or tile behind a button. -->
    <color name="widget_button">#1FFFFFFF</color>

    <!-- The state palette: the same colours as Mochi's states (MochiConst) and WidgetTone. -->
    <color name="widget_tone_muted">#FF94A2B8</color>
    <color name="widget_tone_idle">#FFB8BDC7</color>
    <color name="widget_tone_working">#FF3B9EFF</color>
    <color name="widget_tone_attention">#FFF5A524</color>
    <color name="widget_tone_done">#FF34D499</color>
    <color name="widget_tone_trouble">#FFF4505E</color>

    <!-- The gradient of a card: the tone at 15 to 25 % alpha, fading into the card. -->
    <color name="widget_tint_muted">#2694A2B8</color>
    <color name="widget_tint_idle">#26B8BDC7</color>
    <color name="widget_tint_working">#333B9EFF</color>
    <color name="widget_tint_attention">#40F5A524</color>
    <color name="widget_tint_done">#3334D499</color>
    <color name="widget_tint_trouble">#33F4505E</color>

    <!-- The 1dp border of a card: the tone at 60 % alpha, so the state shows on the edge too. -->
    <color name="widget_border_muted">#9994A2B8</color>
    <color name="widget_border_idle">#99B8BDC7</color>
    <color name="widget_border_working">#993B9EFF</color>
    <color name="widget_border_attention">#99F5A524</color>
    <color name="widget_border_done">#9934D499</color>
    <color name="widget_border_trouble">#99F4505E</color>

    <!-- Text and glyphs drawn on the badge or on a tone colour. -->
    <color name="widget_on_tone">#FF1C1C1E</color>
    <!-- The tone as text colour: the tone itself on the dark card; in day mode a deeper one (see values-notnight). -->
    <color name="widget_tone_attention_text">#FFF5A524</color>

    <!-- Plan usage has its own colours, so it never looks like a state: teal while there is room, yellow from 75 %, red from 90 %.
         The same colours as UsageTone in core/WidgetData.kt. -->
    <color name="widget_usage_calm">#FF0E8F9A</color>
    <color name="widget_usage_close">#FFF2D024</color>
    <color name="widget_usage_limit">#FFD92D20</color>
    <color name="widget_tint_usage_calm">#330E8F9A</color>
    <color name="widget_tint_usage_close">#40F2D024</color>
    <color name="widget_tint_usage_limit">#33D92D20</color>
    <color name="widget_border_usage_calm">#990E8F9A</color>
    <color name="widget_border_usage_close">#99F2D024</color>
    <color name="widget_border_usage_limit">#99D92D20</color>
</resources>
