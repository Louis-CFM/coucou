<?xml version="1.0" encoding="utf-8"?>
<!-- The Status Pill widget: one slim line. On the left a dot in the state's tone, the agent's name and its state word (one line,
     ellipsized: the state word gives way first, then the name); on the right four round buttons (Home, Chat, Settings, Recent)
     that only open a screen of the app. The buttons are measured first, so the text can never run under them. Plain RemoteViews. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pill_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card">

    <FrameLayout
        android:id="@+id/pill_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:background="@drawable/widget_tint_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/pill_dot"
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot"
                android:tint="@color/widget_tone_muted" />

            <TextView
                android:id="@+id/pill_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_initial_title"
                android:textColor="@color/widget_text"
                android:textSize="@dimen/widget_text_name"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pill_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_initial_line"
                android:textColor="@color/widget_text_secondary"
                android:textSize="@dimen/widget_text_state" />
        </LinearLayout>

        <ImageView
            android:id="@+id/pill_btn_home"
            android:layout_width="@dimen/widget_button"
            android:layout_height="@dimen/widget_button"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_bg"
            android:contentDescription="@string/widget_btn_home_cd"
            android:padding="@dimen/widget_button_pad"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_home" />

        <ImageView
            android:id="@+id/pill_btn_chat"
            android:layout_width="@dimen/widget_button"
            android:layout_height="@dimen/widget_button"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_bg"
            android:contentDescription="@string/widget_btn_chat_cd"
            android:padding="@dimen/widget_button_pad"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_chat" />

        <ImageView
            android:id="@+id/pill_btn_settings"
            android:layout_width="@dimen/widget_button"
            android:layout_height="@dimen/widget_button"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_bg"
            android:contentDescription="@string/widget_btn_settings_cd"
            android:padding="@dimen/widget_button_pad"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_settings" />

        <ImageView
            android:id="@+id/pill_btn_recent"
            android:layout_width="@dimen/widget_button"
            android:layout_height="@dimen/widget_button"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_bg"
            android:contentDescription="@string/widget_btn_recent_cd"
            android:padding="@dimen/widget_button_pad"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_recent" />
    </LinearLayout>
</FrameLayout>
