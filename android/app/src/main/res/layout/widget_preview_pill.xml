<?xml version="1.0" encoding="utf-8"?>
<!-- Preview of Status Pill: a blue dot, Claude, Working, and the four round buttons (Home, Chat, Settings, Recent). The sample text is short so nothing is cut at the width of a 4x1 on a 720px phone.
     A still picture for the Widget picker (android:previewLayout): sample text, no ids, nothing from the app, no runtime bitmap.
     It uses the same card, border, gradient, type scale, buttons and state colours as the real Widget, so the picker shows what you will get. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_working">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:background="@drawable/widget_tint_working" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot"
                android:tint="@color/widget_tone_working" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_sample_claude_short"
                android:textColor="@color/widget_text"
                android:textSize="@dimen/widget_text_name"
                android:textStyle="bold" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_sample_working"
                android:textColor="@color/widget_text_secondary"
                android:textSize="@dimen/widget_text_state" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/widget_button"
            android:layout_height="@dimen/widget_button"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_bg"
            android:importantForAccessibility="no"
            android:padding="@dimen/widget_button_pad"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_home" />

        <ImageView
            android:layout_width="@dimen/widget_button"
            android:layout_height="@dimen/widget_button"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_bg"
            android:importantForAccessibility="no"
            android:padding="@dimen/widget_button_pad"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_chat" />

        <ImageView
            android:layout_width="@dimen/widget_button"
            android:layout_height="@dimen/widget_button"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_bg"
            android:importantForAccessibility="no"
            android:padding="@dimen/widget_button_pad"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_settings" />

        <ImageView
            android:layout_width="@dimen/widget_button"
            android:layout_height="@dimen/widget_button"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_bg"
            android:importantForAccessibility="no"
            android:padding="@dimen/widget_button_pad"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_recent" />
    </LinearLayout>
</FrameLayout>
