<?xml version="1.0" encoding="utf-8"?>
<!-- Preview of List: "Waiting for you" with an orange 1 badge, then Claude Code (waiting), Codex (working) and Gemini CLI (finished).
     A still picture for the Widget picker (android:previewLayout): sample text and numbers, no ids, nothing from the app, no runtime bitmap.
     It uses the same card, border, gradient, type scale and state colours as the real Widget, so the picker shows what you will get. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_attention">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:background="@drawable/widget_tint_attention" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot"
                android:tint="@color/widget_tone_attention" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_sample_header"
                android:textColor="@color/widget_text"
                android:textSize="@dimen/widget_text_name"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_badge_bg"
                android:gravity="center"
                android:minWidth="22dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/widget_sample_one"
                android:textColor="@color/widget_on_tone"
                android:textSize="@dimen/widget_text_secondary"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:minHeight="@dimen/widget_row_min"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_stripe"
                android:tint="@color/widget_tone_attention" />

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/preview_face_waiting" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_sample_claude"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_name"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_sample_approval"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_state" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot"
                android:tint="@color/widget_tone_attention" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:minHeight="@dimen/widget_row_min"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_stripe"
                android:tint="@color/widget_tone_working" />

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/preview_face_working" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_sample_codex"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_name"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_sample_working"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_state" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot"
                android:tint="@color/widget_tone_working" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:minHeight="@dimen/widget_row_min"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_stripe"
                android:tint="@color/widget_tone_done" />

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/preview_face_done" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_sample_gemini"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_name"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_sample_finished"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_state" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot"
                android:tint="@color/widget_tone_done" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
