<?xml version="1.0" encoding="utf-8"?>
<!-- The Solo widget: Mochi with a glow in the state's colour (over half the card), the top agent's name with its dot and a state word.
     With no agent the name gives way to a note with an icon ("Not connected"). Plain RemoteViews, no library. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/solo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card">

    <FrameLayout
        android:id="@+id/solo_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:background="@drawable/widget_tint_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="10dp">

        <ImageView
            android:id="@+id/solo_mochi"
            android:src="@drawable/preview_mochi_idle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_solo_label"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/solo_name_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/solo_dot"
                android:tint="@color/widget_tone_muted"
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot" />

            <TextView
                android:id="@+id/solo_name"
                android:text="@string/widget_initial_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="@dimen/widget_text_name"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/solo_note_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/solo_note_icon"
                android:layout_width="@dimen/widget_icon"
                android:layout_height="@dimen/widget_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_offline" />

            <TextView
                android:id="@+id/solo_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_soft"
                android:textSize="@dimen/widget_text_note"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/solo_state"
            android:text="@string/widget_initial_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/widget_text_secondary"
            android:textSize="@dimen/widget_text_state" />
    </LinearLayout>

    <TextView
        android:id="@+id/solo_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/widget_badge_bg"
        android:gravity="center"
        android:minWidth="22dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="@color/widget_on_tone"
        android:textSize="@dimen/widget_text_secondary"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
