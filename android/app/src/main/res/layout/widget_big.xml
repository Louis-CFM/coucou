<?xml version="1.0" encoding="utf-8"?>
<!-- The Mochi Big widget (4x4). Top, in two sides: on the left Mochi with his glow and badge, then the agent's name and state word;
     on the right the plan usage (up to two rows with a big percentage and a thin bar) or one calm message when it is off or the computer is
     not there. Under them, rounded buttons that only open a screen of the app: one row of four at the medium size, two rows of three
     when large, none when small. Until the first update it shows a calm Mochi and a short line. Plain RemoteViews. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/big_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card">

    <FrameLayout
        android:id="@+id/big_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:background="@drawable/widget_tint_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/big_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/big_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="45"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/big_mochi"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/widget_big_label"
                    android:scaleType="fitCenter"
                    android:src="@drawable/preview_mochi_idle" />

                <LinearLayout
                    android:id="@+id/big_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/big_offline"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="2dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_offline"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/big_dot"
                        android:layout_width="@dimen/widget_dot"
                        android:layout_height="@dimen/widget_dot"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/widget_tone_muted" />

                    <TextView
                        android:id="@+id/big_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_text_name"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/big_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_state"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/big_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="55"
                android:gravity="center_vertical"
                android:orientation="vertical">

            <LinearLayout
                android:id="@+id/big_usage_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/big_usage_a_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_secondary" />

                <TextView
                    android:id="@+id/big_usage_a_pct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_pct" />

                <TextView
                    android:id="@+id/big_usage_a_pct_big"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_pct_big"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/big_usage_a_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_soft"
                    android:textSize="@dimen/widget_text_secondary"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/big_usage_a_bar"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="2dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/big_usage_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/big_usage_b_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_secondary" />

                <TextView
                    android:id="@+id/big_usage_b_pct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_pct" />

                <TextView
                    android:id="@+id/big_usage_b_pct_big"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_pct_big"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/big_usage_b_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_soft"
                    android:textSize="@dimen/widget_text_secondary"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/big_usage_b_bar"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="2dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY" />
            </LinearLayout>

                <LinearLayout
                    android:id="@+id/big_off"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/big_off_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/widget_initial_title"
                        android:textColor="@color/widget_text_soft"
                        android:textSize="@dimen/widget_text_note"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/big_off_line"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/widget_initial_line"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="@dimen/widget_text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/big_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/big_buttons_m"
                android:layout_width="match_parent"
                android:layout_height="@dimen/widget_tile_height"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/big_m_home"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_tile_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_home" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/widget_btn_home"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/big_m_chat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_tile_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_chat" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/widget_btn_chat"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/big_m_settings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_tile_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_settings" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/widget_btn_settings"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/big_m_recent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_tile_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_recent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/widget_btn_recent"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/big_buttons_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_tile_height"
                    android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/big_l_home"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_tile_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_home" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/widget_btn_home"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/big_l_chat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_tile_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_chat" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/widget_btn_chat"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/big_l_settings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_tile_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_settings" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/widget_btn_settings"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_text_secondary" />
                </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_tile_height"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/big_l_recent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_tile_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_recent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/widget_btn_recent"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/big_l_session"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_tile_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_session" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/widget_btn_session"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/big_l_pair"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_tile_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_pair" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/widget_btn_pair"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_text_secondary" />
                </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/big_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/widget_badge_bg"
        android:gravity="center"
        android:minWidth="22dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="@color/widget_on_tone"
        android:textSize="@dimen/widget_text_secondary"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
