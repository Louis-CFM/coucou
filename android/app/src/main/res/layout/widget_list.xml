<?xml version="1.0" encoding="utf-8"?>
<!-- The List widget: a card with the headline and a badge, then rows of at least 48dp (stripe, Mochi's face, name, state word, dot).
     With no agent the header and the rows give way to a centred empty state, so the card is never half blank. Plain RemoteViews. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card">

    <FrameLayout
        android:id="@+id/list_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:background="@drawable/widget_tint_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/list_header"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/list_status"
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot" />

            <TextView
                android:id="@+id/list_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="@dimen/widget_text_name"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/list_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_badge_bg"
                android:gravity="center"
                android:minWidth="22dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/widget_on_tone"
                android:textSize="@dimen/widget_text_secondary"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/list_rows"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:id="@+id/list_row0"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_row_min"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/list_stripe0"
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_stripe" />

            <ImageView
                android:id="@+id/list_face0"
                android:contentDescription="@string/widget_list_label"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/list_name0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_name"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/list_state0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_state" />
            </LinearLayout>

            <ImageView
                android:id="@+id/list_dot0"
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/list_row1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_row_min"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/list_stripe1"
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_stripe" />

            <ImageView
                android:id="@+id/list_face1"
                android:contentDescription="@string/widget_list_label"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/list_name1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_name"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/list_state1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_state" />
            </LinearLayout>

            <ImageView
                android:id="@+id/list_dot1"
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/list_row2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_row_min"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/list_stripe2"
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_stripe" />

            <ImageView
                android:id="@+id/list_face2"
                android:contentDescription="@string/widget_list_label"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/list_name2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_name"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/list_state2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_state" />
            </LinearLayout>

            <ImageView
                android:id="@+id/list_dot2"
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/list_row3"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_row_min"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/list_stripe3"
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_stripe" />

            <ImageView
                android:id="@+id/list_face3"
                android:contentDescription="@string/widget_list_label"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/list_name3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_name"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/list_state3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_state" />
            </LinearLayout>

            <ImageView
                android:id="@+id/list_dot3"
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/list_row4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_row_min"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/list_stripe4"
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_stripe" />

            <ImageView
                android:id="@+id/list_face4"
                android:contentDescription="@string/widget_list_label"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/list_name4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_name"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/list_state4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_state" />
            </LinearLayout>

            <ImageView
                android:id="@+id/list_dot4"
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot" />
        </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/list_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/list_empty_face"
                android:src="@drawable/preview_mochi_idle"
                android:contentDescription="@string/widget_list_label"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/list_empty_icon"
                    android:tint="@color/widget_tone_muted"
                    android:layout_width="@dimen/widget_icon"
                    android:layout_height="@dimen/widget_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot" />

                <TextView
                    android:id="@+id/list_empty_title"
                    android:text="@string/widget_initial_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/widget_text_soft"
                    android:textSize="@dimen/widget_text_note"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/list_empty_line"
                android:text="@string/widget_initial_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="@dimen/widget_text_state" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
