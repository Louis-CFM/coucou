<?xml version="1.0" encoding="utf-8"?>
<!-- The Waiting Alert widget: calm when nothing waits, a bright orange count (and an orange border) when something does. Plain RemoteViews. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alert_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card">

    <FrameLayout
        android:id="@+id/alert_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:background="@drawable/widget_tint_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <ImageView
            android:id="@+id/alert_face"
            android:src="@drawable/preview_mochi_idle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_alert_label"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/alert_offline"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_offline"
            android:visibility="gone" />

        <TextView
            android:id="@+id/alert_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_tone_attention_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/alert_calm"
            android:text="@string/widget_initial_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="@dimen/widget_text_name"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alert_sub"
            android:text="@string/widget_initial_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="@dimen/widget_text_state" />
    </LinearLayout>
</FrameLayout>
