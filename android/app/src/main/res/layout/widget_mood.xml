<?xml version="1.0" encoding="utf-8"?>
<!-- The Mochi Mood widget: only Mochi's face in the current state, with his glow. Plain RemoteViews. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mood_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card">

    <FrameLayout
        android:id="@+id/mood_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:background="@drawable/widget_tint_muted" />

    <ImageView
        android:id="@+id/mood_face"
        android:src="@drawable/preview_mochi_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_mood_label"
        android:padding="4dp"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/mood_offline"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="3dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_offline"
        android:visibility="gone" />
</FrameLayout>
