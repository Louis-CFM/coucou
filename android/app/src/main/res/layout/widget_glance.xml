<?xml version="1.0" encoding="utf-8"?>
<!-- The summary widget (3x2) on the shared card: a small Mochi in the state of the most urgent agent on the left; on the right a clear
     headline (with a badge for what waits for you), one detail line when there is room, and up to three short lines with a dot in the
     state's tone. Until the first update it shows a calm Mochi and a short line. A tap anywhere opens the app. Plain RemoteViews. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card">

    <FrameLayout
        android:id="@+id/glance_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:background="@drawable/widget_tint_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/glance_mochi"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/widget_glance_label"
            android:scaleType="fitCenter"
            android:src="@drawable/preview_mochi_idle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/glance_offline"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_offline"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/glance_headline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_initial_title"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_name"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/glance_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_badge_bg"
                    android:gravity="center"
                    android:minWidth="22dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textColor="@color/widget_on_tone"
                    android:textSize="@dimen/widget_text_secondary"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/glance_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_initial_line"
                android:textColor="@color/widget_text_secondary"
                android:textSize="@dimen/widget_text_secondary" />

            <LinearLayout
                android:id="@+id/glance_row0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/glance_dot0"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot" />

                <TextView
                    android:id="@+id/glance_name0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_state"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/glance_text0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/glance_row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/glance_dot1"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot" />

                <TextView
                    android:id="@+id/glance_name1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_state"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/glance_text1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/glance_row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/glance_dot2"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot" />

                <TextView
                    android:id="@+id/glance_name2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_state"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/glance_text2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
