<?xml version="1.0" encoding="utf-8"?>
<!-- The soft light behind Mochi in the "idle" state: the state's colour fading out, like the glow MochiBitmap draws at runtime. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    <path android:pathData="M0,0 h120 v120 h-120 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="60" android:centerY="60" android:gradientRadius="60">
                <item android:offset="0" android:color="#5294A2B8" />
                <item android:offset="1" android:color="#0094A2B8" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
