<?xml version="1.0" encoding="utf-8"?>
<!-- The picture the Widget picker shows on Android 11 (no previewLayout there): the card, its gradient and Mochi in the states of the sample. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/widget_card_attention" />
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp"
        android:drawable="@drawable/widget_tint_attention" />
    <item
        android:width="40dp"
        android:height="40dp"
        android:left="16dp"
        android:top="14dp"
        android:gravity="start|top"
        android:drawable="@drawable/preview_face_waiting" />
    <item
        android:width="40dp"
        android:height="40dp"
        android:left="150dp"
        android:top="14dp"
        android:gravity="start|top"
        android:drawable="@drawable/preview_face_working" />
    <item
        android:width="40dp"
        android:height="40dp"
        android:left="16dp"
        android:top="62dp"
        android:gravity="start|top"
        android:drawable="@drawable/preview_face_done" />
</layer-list>
