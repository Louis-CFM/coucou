{
  "id": "blush",
  "name": "Blush",
  "kind": "face",
  "layer": "front",
  "lookRange": 0.5,
  "_about": "Pink cheeks with three freckles each. They sit on the face, so they slide round and narrow as the head turns, and the far one disappears.",
