{
  "id": "mustache",
  "name": "Moustache",
  "kind": "face",
  "layer": "front",
  "lookRange": 0.5,
  "_about": "A handlebar moustache: two halves, thick at the middle, tapering to tips that curl up. It sits under the eyes and slides and narrows with the head.",
  "vars": {
    "cv": "cos(yaw)",
    "mx": "rx*0.88*sin(yaw)",
    "my": "ry*0.54",
    "mw": "R*0.60*(0.40+0.60*cos(yaw))"
