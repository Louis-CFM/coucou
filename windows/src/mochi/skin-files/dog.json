{
  "id": "dog",
  "name": "Dog",
  "kind": "face",
  "layer": "front",
  "lookRange": 0.4,
  "_about": "Floppy brown ears at the sides, a cream muzzle, a big black nose and a pink tongue. The ears swing round with the head, the muzzle slides and narrows.",
