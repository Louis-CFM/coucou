    { "type": "ellipse", "layer": "behind", "when": "0.5 - rc", "x": "rxx - rw", "y": "0 - ry*0.62", "w": "2*rw", "h": "R*1.0",
      "fill": { "gradient": ["#B4763F", "#6B3F1D"], "from": ["rxx", "0 - ry*0.6"], "to": ["rxx", "ry*0.4"] }, "stroke": "rgba(0,0,0,0.22)", "lineWidth": 0.8 },
    { "type": "ellipse", "when": "rc - 0.5", "x": "rxx - rw", "y": "0 - ry*0.62", "w": "2*rw", "h": "R*1.0",
      "fill": { "gradient": ["#B4763F", "#6B3F1D"], "from": ["rxx", "0 - ry*0.6"], "to": ["rxx", "ry*0.4"] }, "stroke": "rgba(0,0,0,0.22)", "lineWidth": 0.8 },
    { "type": "ellipse", "follow": true, "clip": true, "x": "mx - mw/2", "y": "my - R*0.19", "w": "mw", "h": "R*0.40", "fill": "rgba(250,236,214,0.96)" },
    { "type": "ellipse", "follow": true, "clip": true, "x": "mx - nw*0.28", "y": "my + R*0.06", "w": "nw*0.56", "h": "R*0.27",
      "fill": { "gradient": ["#FF8FA3", "#E64A6B"], "from": ["mx", "my"], "to": ["mx", "my + R*0.3"] }, "stroke": "rgba(0,0,0,0.2)", "lineWidth": 0.7 },
    { "type": "ellipse", "follow": true, "clip": true, "x": "nx - nw/2", "y": "ny - R*0.12", "w": "nw", "h": "R*0.24",
