    "ny": "ry*0.40",
    "nc": "0.5+0.5*C"
  },
  "shapes": [
    { "type": "poly", "layer": "behind", "when": "aLc + 0.35",
      "points": [["rx*aL*0.80 - eW*(0.4+0.6*aLc)", "0 - ry*head(aL*0.80) + R*0.22"], ["rx*aL*0.80 + eW*(0.4+0.6*aLc)", "0 - ry*head(aL*0.80) + R*0.22"], ["rx*aL*0.86 + R*0.10*S", "0 - ry*head(aL*0.80) - R*0.52"]],
      "fill": "#F29B45", "stroke": "rgba(0,0,0,0.22)", "lineWidth": 0.8 },
    { "type": "poly", "layer": "behind", "when": "aLc + 0.35",
      "points": [["rx*aL*0.80 - eW*0.5*(0.4+0.6*aLc)", "0 - ry*head(aL*0.80) + R*0.16"], ["rx*aL*0.80 + eW*0.5*(0.4+0.6*aLc)", "0 - ry*head(aL*0.80) + R*0.16"], ["rx*aL*0.85 + R*0.08*S", "0 - ry*head(aL*0.80) - R*0.30"]],
      "fill": "#F9A8C0" },
    { "type": "poly", "layer": "behind", "when": "aRc + 0.35",
      "points": [["rx*aR*0.80 - eW*(0.4+0.6*aRc)", "0 - ry*head(aR*0.80) + R*0.22"], ["rx*aR*0.80 + eW*(0.4+0.6*aRc)", "0 - ry*head(aR*0.80) + R*0.22"], ["rx*aR*0.86 + R*0.10*S", "0 - ry*head(aR*0.80) - R*0.52"]],
      "fill": "#F29B45", "stroke": "rgba(0,0,0,0.22)", "lineWidth": 0.8 },
    { "type": "poly", "layer": "behind", "when": "aRc + 0.35",
      "points": [["rx*aR*0.80 - eW*0.5*(0.4+0.6*aRc)", "0 - ry*head(aR*0.80) + R*0.16"], ["rx*aR*0.80 + eW*0.5*(0.4+0.6*aRc)", "0 - ry*head(aR*0.80) + R*0.16"], ["rx*aR*0.85 + R*0.08*S", "0 - ry*head(aR*0.80) - R*0.30"]],
      "fill": "#F9A8C0" },
    { "type": "repeat", "count": 3, "as": "i", "vars": { "l": "(i-1)*0.20", "ps": "sin(l+yaw)", "pc": "cos(l+yaw)" }, "shapes": [
      { "type": "meridian", "layer": "body", "lon": "l", "width": "0.045", "from": -0.97, "to": "-0.55 + 0.06*abs(i-1)", "fill": "rgba(150,70,10,0.50)" }
    ] },
    { "type": "poly", "follow": true, "clip": true, "points": [["nx - R*0.11*nc", "ny - R*0.05"], ["nx + R*0.11*nc", "ny - R*0.05"], ["nx", "ny + R*0.07"]],
      "fill": "#F43F7A", "stroke": "rgba(0,0,0,0.2)", "lineWidth": 0.6 },
    { "type": "band", "follow": true, "clip": true, "from": 0, "to": 1, "steps": 8, "x": "nx - u*R*0.17*nc", "top": "ny + R*0.075 + R*0.06*sin(u*3.1)", "bottom": "ny + R*0.075 + R*0.06*sin(u*3.1) + 1.3", "fill": "rgba(70,30,10,0.75)" },
    { "type": "band", "follow": true, "clip": true, "from": 0, "to": 1, "steps": 8, "x": "nx + u*R*0.17*nc", "top": "ny + R*0.075 + R*0.06*sin(u*3.1)", "bottom": "ny + R*0.075 + R*0.06*sin(u*3.1) + 1.3", "fill": "rgba(70,30,10,0.75)" },
    { "type": "repeat", "count": 3, "as": "i", "vars": { "wl": "cos(-0.66+yaw)", "wr": "cos(0.66+yaw)", "y0": "ry*0.50 + (i-1)*R*0.075" }, "shapes": [
      { "type": "band", "follow": true, "when": "wl - 0.2", "from": 0, "to": 1, "steps": 4, "x": "rx*sin(-0.66+yaw)*0.92 - u*R*0.62*wl", "top": "y0 + (i-1)*R*0.10*u - 0.6", "bottom": "y0 + (i-1)*R*0.10*u + 0.6", "fill": "rgba(60,40,30,0.6)" },
      { "type": "band", "follow": true, "when": "wr - 0.2", "from": 0, "to": 1, "steps": 4, "x": "rx*sin(0.66+yaw)*0.92 + u*R*0.62*wr", "top": "y0 + (i-1)*R*0.10*u - 0.6", "bottom": "y0 + (i-1)*R*0.10*u + 0.6", "fill": "rgba(60,40,30,0.6)" }
    ] }
