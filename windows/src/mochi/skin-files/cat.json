{
  "id": "cat",
  "name": "Cat",
  "kind": "face",
  "layer": "front",
  "lookRange": 0.5,
  "glow": "#FB923C",
  "_about": "A ginger tabby: pointed ears that turn with the head, forehead stripes, a pink nose and whiskers.",
  "body": ["#FFC48A", "#EE8A2E"],
  "vars": {
