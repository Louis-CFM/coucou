{
  "name": "coucou-windows",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "predev": "cargo build --release -p coucou-hook",
    "prebuild": "cargo build --release -p coucou-hook",
    "pack": "tauri build && node scripts/pack.mjs",
    "pack:exe": "tauri build --bundles nsis && node scripts/pack.mjs",
    "test:pills": "esbuild tests/pill-budget.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/pill-budget.mjs --log-level=error && node node_modules/.cache/pill-budget.mjs",
    "test:mochi": "esbuild tests/desktop-mochi.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/desktop-mochi.mjs --log-level=error && node node_modules/.cache/desktop-mochi.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
